# =============================================================================
# .env.example  —  Agri-Market Intelligence Platform
#
# Copy to .env and fill in real values. No secret may appear here.
# Every APP_* variable maps to a Settings field in app/config.py.
# Variable lookup priority (highest first):
#   1. Real environment variables
#   2. This .env file
#   3. pydantic-settings defaults
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENVIRONMENT=local                  # local | staging | production
APP_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
APP_APP_NAME=Agri-Market Intelligence Platform
APP_APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────────────────────────────
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/agrimarket
APP_DB_STATEMENT_TIMEOUT_MS=15000
APP_CHECK_ALEMBIC_HEAD=false

# ── Security / JWT ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_JWT_SECRET_KEY=fe50398e4742a2abf091c5543ce29ea9f35989f00ccd5cab8407123aeb413949
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis / Cache ─────────────────────────────────────────────────────────────
# Also accepted as bare REDIS_URL (legacy alias)
APP_REDIS_URL=redis://localhost:6379/0
APP_REDIS_POOL_SIZE=50
APP_REDIS_TIMEOUT_MS=1500
APP_CACHE_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. Also accepted as bare CORS_ORIGINS (legacy alias).
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5500,http://localhost:5500

# ── Kafka ─────────────────────────────────────────────────────────────────────
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_CLIENT_ID=agri-platform
APP_KAFKA_ACKS=all
APP_KAFKA_ENABLE_IDEMPOTENCE=true
APP_KAFKA_LINGER_MS=10
APP_KAFKA_MAX_BATCH_SIZE=16384
APP_KAFKA_MAX_RETRY_ATTEMPTS=5
APP_KAFKA_RETRY_BACKOFF_MS=100
APP_KAFKA_DLQ_TOPIC=agri.dlq
APP_KAFKA_DEFAULT_RETENTION_MS=604800000
APP_KAFKA_COMPLIANCE_RETENTION_MS=31536000000

# ── NATS JetStream ────────────────────────────────────────────────────────────
APP_NATS_URL=nats://localhost:4222
APP_NATS_JETSTREAM_MAX_MESSAGES=100000
APP_NATS_JETSTREAM_MAX_BYTES=104857600
APP_NATS_JETSTREAM_MAX_AGE_SECONDS=604800
APP_NATS_JETSTREAM_DEDUP_WINDOW_SECONDS=120

# ── Event Outbox / Relay ──────────────────────────────────────────────────────
APP_EVENT_OUTBOX_BATCH_SIZE=100

# ── External Data APIs ────────────────────────────────────────────────────────
# data.gov.in AGMARKNET
APP_DATA_GOV_API_KEY=CHANGE_ME
APP_DATA_GOV_RESOURCE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Weather — also accepted as bare OPENWEATHER_API_KEY / IMD_API_KEY
APP_OPENWEATHER_API_KEY=CHANGE_ME
APP_IMD_API_KEY=CHANGE_ME

# ── AgriStack / UFSI ─────────────────────────────────────────────────────────
APP_UFSI_BASE_URL=https://ufsi.agristack.gov.in
APP_AGRISTACK_API_KEY=CHANGE_ME
APP_AGRISTACK_BASE_URL=https://api.agristack.gov.in

# ── Consent / Assay signing ───────────────────────────────────────────────────
# Generate with: python scripts/gen_dev_secrets.py
APP_CONSENT_SIGNING_SECRET=e4e0ab7d2632e52e192b50de7448f6b49d74ca81369b350cfc2d186061aefe28
APP_CONSENT_MANAGER_WEBHOOK_SECRET=e4e0ab7d2632e52e192b50de7448f6b49d74ca81369b350cfc2d186061aefe28
APP_ASSAY_HMAC_SECRET=6a2bb8069f13a58b1b28ba57101dbb7254c4400dbc1124423797119d96839442

# ── ONDC / Beckn BPP ─────────────────────────────────────────────────────────
APP_ONDC_BPP_ID=market.example.in
APP_ONDC_BPP_URI=https://market.example.in/beckn
APP_ONDC_BPP_NAME=AgriMarket BPP
APP_ONDC_COMMISSION_PERCENT=0
APP_ONDC_SUPPORT_PHONE=+911800123456
APP_ONDC_SUPPORT_EMAIL=grievance@market.example.in
APP_ONDC_TRACKING_BASE_URL=https://track.market.example.in/shipments
APP_ONDC_AUTH_ENABLED=false
# Hex-encoded 32-byte Ed25519 private key seed (required when ONDC_AUTH_ENABLED=true)
# Generate with: python scripts/gen_dev_secrets.py
APP_ONDC_SIGNING_PRIVATE_KEY_HEX=05dadd56a384abf8fc30be0af1a7371e2e85bf5ef84a990a2f3307710c664873
APP_ONDC_UNIQUE_KEY_ID=key-1

# ── ONDC / Beckn BAP ─────────────────────────────────────────────────────────
APP_ONDC_BAP_ID=buyer.market.example.in
APP_ONDC_BAP_URI=https://market.example.in/beckn/bap
APP_ONDC_REGISTRY_URL=https://preprod.registry.ondc.org/ondc/subscriber-info

# ── eNAM integration ─────────────────────────────────────────────────────────
APP_ENAM_BASE_URL=https://enam.gov.in/api

# ── e-RUPI / Settlement ───────────────────────────────────────────────────────
APP_ERUPI_ISSUER_ID=ONDC-RSP-PARTNER-BANK
APP_ERUPI_VALIDITY_DAYS=30
APP_SETTLEMENT_TDS_RATE_BPS=100

# ── Pledge Finance ────────────────────────────────────────────────────────────
APP_PLEDGE_FINANCE_DEFAULT_LTV_BPS=7500
APP_PLEDGE_FINANCE_DEFAULT_INTEREST_BPS=700
APP_PLEDGE_FINANCE_DEFAULT_LENDER=NABARD Agri-Credit Partner Bank

# ── HTTP Client (outbound) ────────────────────────────────────────────────────
APP_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
APP_HTTP_READ_TIMEOUT_SECONDS=15.0
APP_HTTP_WRITE_TIMEOUT_SECONDS=10.0
APP_HTTP_POOL_TIMEOUT_SECONDS=5.0
APP_HTTP_MAX_REDIRECTS=5
APP_HTTP_SSRF_ALLOW_PRIVATE=false
APP_MAX_REQUEST_BODY_SIZE_BYTES=52428800

# ── Server ────────────────────────────────────────────────────────────────────
APP_SERVER_REQUEST_TIMEOUT_SECONDS=30.0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
APP_RATE_LIMIT_PER_MINUTE_DEFAULT=100
APP_RATE_LIMIT_PER_MINUTE_AUTH=20
APP_RATE_LIMIT_PER_MINUTE_PRICES=500

# ── Inference / ML ────────────────────────────────────────────────────────────
APP_INFERENCE_CONCURRENCY=4
APP_INFERENCE_TIMEOUT_MS=5000
APP_MODELS_DIR=models

# ── Observability — OpenTelemetry (OTEL_* are spec-defined; no APP_ prefix needed) ──
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing (strict no-op).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agri-platform-backend
OTEL_EXPORTER_OTLP_INSECURE=true

# ── Observability — Prometheus /metrics ───────────────────────────────────────
# Also accepted as APP_METRICS_TOKEN
METRICS_BEARER_TOKEN=5eccaa1e68b41196a9feaaaf3f521b38fd994d601d312dc6c0a56be0e9ffc5e7

# ── Workers ───────────────────────────────────────────────────────────────────
APP_RUN_WORKERS_INLINE=false
